# Port exposed by the container
PORT=3000

# Secret used to sign JWT session tokens - generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Initial admin account, created automatically on first boot if it doesn't exist yet
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Source des films : cinemeta (défaut) ou wikipedia (retour arrière temporaire pendant la migration)
MOVIE_PROVIDER=cinemeta

# Optionnel mais fortement recommandé : clé API TMDB (gratuite, https://www.themoviedb.org/settings/api)
# Utilisée comme source d'appoint pour les affiches de films.
TMDB_API_KEY=changeme
